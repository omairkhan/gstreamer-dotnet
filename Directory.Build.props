<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- GirCore wrappers expose a few APIs we intentionally use from background threads. -->
    <NoWarn>$(NoWarn);CA1848;CA1873;CA2254;CA1716;CA1711;CA1720;CA1819;CA1515;CA1062;CA2007;CA1031;CA1303;CA1305;CA1307;CA1310;CA1822;CA1859;CA1812;CA1708</NoWarn>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <Authors>Umair Akhter</Authors>
    <RepositoryUrl>https://github.com/omairkhan/gstreamer-dotnet</RepositoryUrl>
  </PropertyGroup>
</Project>
